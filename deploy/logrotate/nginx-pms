# Installed to /etc/logrotate.d/nginx-pms by deploy/bootstrap-server.sh. Ubuntu's nginx
# package already ships a default /etc/logrotate.d/nginx that would rotate these too; this
# file exists alongside it to make retention/compression explicit for our four vhosts rather
# than relying on the package default staying as-is.
/var/log/nginx/pms.aryanb.dev.access.log
/var/log/nginx/pms.aryanb.dev.error.log
/var/log/nginx/aryanb.dev.access.log
/var/log/nginx/aryanb.dev.error.log
/var/log/nginx/docs.aryanb.dev.access.log
/var/log/nginx/docs.aryanb.dev.error.log
/var/log/nginx/renewalflow.aryanb.dev.access.log
/var/log/nginx/renewalflow.aryanb.dev.error.log
{
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
