# Copy this file to deploy/postgres-demo.env (gitignored) on the server and set a strong
# password before running docker-compose.yml's postgres-demo service in production —
# the checked-in docker-compose.yml default (pms_demo_dev) is fine for local dev only.
#
#   cp deploy/postgres-demo.env.example deploy/postgres-demo.env
#   openssl rand -base64 24    # generate a strong value for POSTGRES_DEMO_PASSWORD
#
# Used as: docker compose --env-file deploy/postgres-demo.env up -d postgres-demo

POSTGRES_DEMO_PASSWORD=change-me-to-a-long-random-value
