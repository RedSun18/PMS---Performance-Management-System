# PMS Demo — Performance Management System, ASPNETCORE_ENVIRONMENT=Demo (Apex Corporation
# fictional data only — this unit must never point at the real Development database, see
# deploy/RUNBOOK.md and docs/DEMO.md).
#
# Install: sudo cp deploy/systemd/pms-demo.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now pms-demo
#
# deploy/publish.sh flips /var/www/pms-demo/current to point at the latest release and
# restarts this unit; it never edits this file.

[Unit]
Description=PMS Demo (Performance Management System, Demo environment)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=pms-demo
Group=pms-demo

WorkingDirectory=/var/www/pms-demo/current
ExecStart=/usr/bin/dotnet /var/www/pms-demo/current/PerformanceManagement.Web.dll

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# HOME set explicitly (not just via the pms-demo passwd entry) so ASP.NET Core's Data
# Protection key ring reliably persists to $HOME/.aspnet/DataProtection-Keys across restarts
# and redeploys — otherwise the SMTP password (Settings > Email) and signed /OpenForm links
# would silently break on every restart. Same directory doubles as PuppeteerSharp's Chromium
# cache location.
Environment=HOME=/var/www/pms-demo
Environment=DOTNET_ENVIRONMENT=Demo
Environment=ASPNETCORE_ENVIRONMENT=Demo
# Port 8090 is duplicated (by necessity — a systemd unit, an Nginx conf, and a bash script
# can't share a variable) in deploy/nginx/pms.aryanb.dev.conf's proxy_pass and
# deploy/publish.sh's HEALTH_URL. Change all three together if it ever needs to change.
Environment=ASPNETCORE_URLS=http://127.0.0.1:8090
# Not a secret — the app's own public URL, used to build signed /OpenForm links in emails.
Environment=General__ApplicationBaseUrl=https://pms.aryanb.dev

# ConnectionStrings__Pm (the Demo Postgres connection string/password) lives here, never in
# git. Must be this exact env var name, not PM_CONNECTION — appsettings.Demo.json ships its
# own checked-in ConnectionStrings:Pm (a local-dev convenience default), which
# Program.cs's `GetConnectionString("Pm")` call already satisfies before ever falling back to
# a PM_CONNECTION env var; only the ConnectionStrings__Pm double-underscore form outranks an
# appsettings.*.json value in the default ASP.NET Core configuration order. Verified by
# actually running the published app both ways — see deploy/bootstrap-server.sh's comment at
# the point this file is generated for the full explanation.
# AUTO-GENERATED by deploy/bootstrap-server.sh from the repo's .env (POSTGRES_DEMO_PASSWORD)
# — the ONE place that password is set; do not hand-edit this file directly, it's
# overwritten on every bootstrap run. See .env.example and deploy/RUNBOOK.md.
EnvironmentFile=/var/www/pms-demo/shared/pms-demo.env

# Hardening: the app only ever needs to read its own release tree and write under its own
# home (uploads, Data Protection keys, the Chromium cache) — nothing else on the box.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/www/pms-demo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
