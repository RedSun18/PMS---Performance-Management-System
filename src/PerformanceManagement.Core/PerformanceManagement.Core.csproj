<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Local dev machine has only the .NET 9 runtime installed; net8.0 assemblies
         roll forward to it. See README "Runtime note". -->
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageReference Include="PuppeteerSharp" Version="20.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled (not embedded resources) so PdfRenderer can hand Chromium plain file:// URLs —
         see PdfRenderer. Noto Sans / Noto Sans Arabic are SIL Open Font Licensed; freely
         redistributable — see Fonts/LICENSE.txt. Also copied into the Web project's wwwroot for
         on-screen use (site.css); this copy is the one the headless-Chromium PDF pipeline reads. -->
    <None Include="Fonts\*.woff2" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fonts\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
