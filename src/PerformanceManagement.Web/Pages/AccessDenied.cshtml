@page
@model PerformanceManagement.Web.Pages.AccessDeniedModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}
<div class="page-header danger">@Localizer["PageTitle"]</div>
<div class="card">
    <div class="card-body">
        <div class="alert alert-error">
            @Localizer["NoPermissionMessage"]
            @if (!string.IsNullOrWhiteSpace(Model.Detail))
            {
                <br /><span>@Model.Detail</span>
            }
        </div>
        <p class="muted">
            @Localizer["AccessRulesExplanation"]
        </p>
        <a class="btn btn-primary" asp-page="/PmForm/Index">@Localizer["BackToMyPmFormButton"]</a>
    </div>
</div>
