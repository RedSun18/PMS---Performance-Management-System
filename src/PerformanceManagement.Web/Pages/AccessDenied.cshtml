@page
@model PerformanceManagement.Web.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}
<div class="page-header danger">Access Denied</div>
<div class="card">
    <div class="card-body">
        <div class="alert alert-error">
            You do not have permission to view or act on this record.
            @if (!string.IsNullOrWhiteSpace(Model.Detail))
            {
                <br /><span>@Model.Detail</span>
            }
        </div>
        <p class="muted">
            Employees may only access their own PM form. Managers may only access forms
            belonging to their direct reports. HR administrators may access any form.
        </p>
        <a class="btn btn-primary" asp-page="/PmForm/Index">Back to my PM Form</a>
    </div>
</div>
