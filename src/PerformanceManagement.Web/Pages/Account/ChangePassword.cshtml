@page
@model PerformanceManagement.Web.Pages.Account.ChangePasswordModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}
<div class="login-box card">
    <div class="card-header">@Localizer["PageTitle"]</div>
    <div class="card-body">
        @if (Model.IsForced)
        {
            <div class="alert alert-warn">
                @Localizer["ForcedChangeWarning"]
            </div>
        }
        @if (Model.Error is not null)
        {
            <div class="alert alert-error">@Model.Error</div>
        }
        <form method="post">
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div style="margin-bottom:12px;">
                <label for="currentPassword">@Localizer["CurrentPasswordLabel"]</label>
                <input type="password" id="currentPassword" name="currentPassword" autofocus />
            </div>
            <div style="margin-bottom:12px;">
                <label for="newPassword">@Localizer["NewPasswordLabel"]</label>
                <input type="password" id="newPassword" name="newPassword" />
                <p class="muted" style="margin:4px 0 0;font-size:12px;">@Model.PasswordRuleHint</p>
            </div>
            <div style="margin-bottom:16px;">
                <label for="confirmPassword">@Localizer["ConfirmNewPasswordLabel"]</label>
                <input type="password" id="confirmPassword" name="confirmPassword" />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">@Localizer["ChangePasswordButton"]</button>
        </form>
    </div>
</div>
