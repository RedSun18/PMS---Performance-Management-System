@page
@model PerformanceManagement.Web.Pages.Account.LoginModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    // ViewData["Title"] is a plain string consumed via string interpolation in _Layout, not
    // rendered as HTML — IViewLocalizer's indexer returns LocalizedHtmlString, whose ToString()
    // is the CLR default (the type name), not the resolved text. Its .Value property has the
    // actual resolved string.
    ViewData["Title"] = Localizer["PageTitle"].Value;
    Layout = "_Layout";
}
<div class="login-box card">
    <div class="card-header">@Localizer["CardHeader", SharedLocalizer["ApplicationName"]]</div>
    <div class="card-body">
        @if (Model.Error is not null)
        {
            <div class="alert alert-error">@Model.Error</div>
        }
        <form method="post" data-no-dirty-check>
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div style="margin-bottom:12px;">
                <label for="username">@SharedLocalizer["Username"]</label>
                <input type="text" id="username" name="username" value="@Model.Username" autofocus />
            </div>
            <div style="margin-bottom:16px;">
                <label for="password">@SharedLocalizer["Password"]</label>
                <input type="password" id="password" name="password" />
            </div>
            <div style="margin-bottom:16px;">
                <label style="text-transform:none;"><input type="checkbox" id="rememberMe" name="rememberMe" value="true" style="width:auto;" /> @Localizer["RememberMe"]</label>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;">@SharedLocalizer["SignIn"]</button>
        </form>
        <p class="muted" style="margin-top:14px;">
            @Localizer["DevAccountsHint"]
        </p>
    </div>
</div>
