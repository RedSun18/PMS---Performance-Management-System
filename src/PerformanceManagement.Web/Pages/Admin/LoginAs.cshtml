@page
@model PerformanceManagement.Web.Pages.Admin.LoginAsModel
@{
    ViewData["Title"] = "Login As";
}
<div class="page-header">Administrator — Login As</div>

@if (Model.Error is not null) { <div class="alert alert-error">@Model.Error</div> }

@if (!Model.Verified)
{
    <div class="card">
        <div class="card-header">Administrator Verification</div>
        <div class="card-body">
            <p class="muted" style="margin-top:0;">
                Enter the secondary verification password to continue. This is separate from
                your account password and is required before any user list is shown.
            </p>
            <form method="post" asp-page-handler="Verify">
                <div style="max-width:340px;">
                    <label for="verificationPassword">Verification Password</label>
                    <input type="password" id="verificationPassword" name="verificationPassword" autofocus />
                </div>
                <div class="form-actions" style="margin-top:14px;">
                    <button type="submit" class="btn btn-primary">Continue</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">Select User</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Impersonate">
                <div class="grid-2" style="align-items:end;">
                    <div>
                        <label for="userSelect">User</label>
                        <select name="userId" id="userSelect">
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id">@u.Id | @u.DisplayName@(string.IsNullOrEmpty(u.EmpCode) ? "" : $" | Employee {u.EmpCode}") (@u.UserName)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-danger">Login As User</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Recent Impersonation History</div>
        <div class="card-body">
            <div class="table-scroll">
            <table class="grid">
                <thead>
                    <tr><th>Administrator</th><th>Impersonated User</th><th>Started</th><th>Ended</th><th>IP Address</th><th>Session</th></tr>
                </thead>
                <tbody>
                @foreach (var h in Model.RecentHistory)
                {
                    <tr>
                        <td>@h.AdminDisplayName (@h.AdminUserName)</td>
                        <td>@h.ImpersonatedDisplayName@(string.IsNullOrEmpty(h.ImpersonatedEmpCode) ? "" : $" ({h.ImpersonatedEmpCode})") (@h.ImpersonatedUserName)</td>
                        <td>@h.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(h.EndedAt?.ToString("yyyy-MM-dd HH:mm") ?? "— in progress —")</td>
                        <td>@h.IpAddress</td>
                        <td class="muted">@h.SessionId</td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            @if (Model.RecentHistory.Count == 0)
            {
                <p class="muted">No impersonation sessions recorded yet.</p>
            }
        </div>
    </div>
}
