@page
@model PerformanceManagement.Web.Pages.Admin.LoginAsModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavLoginAs"].Value;
}
<div class="page-header">@Localizer["PageHeader", SharedLocalizer["NavLoginAs"]]</div>

@if (Model.Error is not null) { <div class="alert alert-error">@Model.Error</div> }

@if (!Model.Verified)
{
    <div class="card">
        <div class="card-header">@Localizer["VerificationHeader"]</div>
        <div class="card-body">
            <p class="muted" style="margin-top:0;">
                @Localizer["VerificationIntro"]
            </p>
            <form method="post" asp-page-handler="Verify">
                <div style="max-width:340px;">
                    <label for="verificationPassword">@Localizer["VerificationPasswordLabel"]</label>
                    <input type="password" id="verificationPassword" name="verificationPassword" autofocus />
                </div>
                <div class="form-actions" style="margin-top:14px;">
                    <button type="submit" class="btn btn-primary">@SharedLocalizer["Continue"]</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">@Localizer["SelectUserHeader"]</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Impersonate">
                <div class="grid-2" style="align-items:end;">
                    <div>
                        <label for="userSelect">@Localizer["UserLabel"]</label>
                        <select name="userId" id="userSelect" data-searchable>
                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id">@u.Id | @u.DisplayName@(string.IsNullOrEmpty(u.EmpCode) ? "" : Localizer["EmployeeInlineLabel", u.EmpCode].Value) (@u.UserName)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-danger">@Localizer["LoginAsUserButton"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">@Localizer["RecentHistoryHeader"]</div>
        <div class="card-body">
            <div class="table-scroll">
            <table class="grid">
                <thead>
                    <tr><th>@Localizer["AdministratorColumn"]</th><th>@Localizer["ImpersonatedUserColumn"]</th><th>@Localizer["StartedColumn"]</th><th>@Localizer["EndedColumn"]</th><th>@Localizer["IpAddressColumn"]</th><th>@Localizer["SessionColumn"]</th></tr>
                </thead>
                <tbody>
                @foreach (var h in Model.RecentHistory)
                {
                    <tr>
                        <td>@h.AdminDisplayName (@h.AdminUserName)</td>
                        <td>@h.ImpersonatedDisplayName@(string.IsNullOrEmpty(h.ImpersonatedEmpCode) ? "" : $" ({h.ImpersonatedEmpCode})") (@h.ImpersonatedUserName)</td>
                        <td>@h.StartedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(h.EndedAt?.ToString("yyyy-MM-dd HH:mm") ?? Localizer["InProgressPlaceholder"].Value)</td>
                        <td>@h.IpAddress</td>
                        <td class="muted">@h.SessionId</td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            @if (Model.RecentHistory.Count == 0)
            {
                <p class="muted">@Localizer["NoHistoryMessage"]</p>
            }
        </div>
    </div>
}
