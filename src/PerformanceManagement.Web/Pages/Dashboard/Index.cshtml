@page
@using PerformanceManagement.Core.Domain
@model PerformanceManagement.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-header">Dashboard</div>

@if (!string.IsNullOrWhiteSpace(Model.AnnouncementBanner))
{
    <div class="alert alert-warn" style="margin-bottom:16px;">📢 @Model.AnnouncementBanner</div>
}
@if (!string.IsNullOrWhiteSpace(Model.WelcomeMessage))
{
    <p class="muted" style="margin:-8px 0 20px;font-size:14.5px;">@Model.WelcomeMessage</p>
}

@if (Model.DashboardKind == "employee")
{
    <div class="card" style="margin-bottom:20px;">
        <div class="card-header">My @Model.EvalYear Performance Review</div>
        <div class="card-body">
            <div class="status-chip" style="margin-bottom:10px;">
                <span class="status-dot"></span> Current Stage: <strong>@Model.MyStatusLabel</strong>
            </div>
            <div class="progress-outer">
                <div class="progress-inner" style="width:@(Model.MyProgressPercent)%;">@Model.MyProgressPercent%</div>
            </div>
            @if (Model.MyDeadlineHint is not null)
            {
                <p class="muted" style="margin:12px 0 0;">⏰ @Model.MyDeadlineHint</p>
            }
        </div>
    </div>

    <div class="card" style="margin-bottom:20px;">
        <div class="card-header">Completion Breakdown</div>
        <div class="perf-metrics">
            <div class="perf-metric">
                <div class="label">Overall Progress</div>
                <div class="value">@Model.MyProgressPercent%</div>
            </div>
            <div class="perf-metric">
                <div class="label">KPI Completion</div>
                <div class="value">@Model.MyKpiCompletionPercent%</div>
            </div>
            <div class="perf-metric">
                <div class="label">Competency Completion</div>
                <div class="value">@Model.MyCompCompletionPercent%</div>
            </div>
            <div class="perf-metric">
                <div class="label">Items Recorded</div>
                <div class="value">@(Model.MyForm?.Kpis.Count ?? 0) / @(Model.MyForm?.Competencies.Count ?? 0)</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Recent Notifications</div>
        <div class="card-body">
            @if (Model.MyRecentNotifications.Count == 0)
            {
                <p class="muted" style="margin:0;">No notifications yet.</p>
            }
            else
            {
                @foreach (var n in Model.MyRecentNotifications)
                {
                    <div style="padding:10px 0;border-bottom:1px solid var(--border);">
                        <div style="font-weight:600;">@n.Subject</div>
                        <div class="muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="form-actions" style="margin-top:20px;">
        <a class="btn btn-primary" asp-page="/PmForm/Index">Open My PM Form</a>
    </div>
}
else if (Model.DashboardKind == "manager")
{
    <div class="summary-cards">
        <div class="summary-card blue">
            <div class="label">Team Members</div>
            <div class="value">@Model.TeamCount</div>
        </div>
        <div class="summary-card grey">
            <div class="label">Waiting for Your Review</div>
            <div class="value">@Model.WaitingForReviewCount</div>
        </div>
        <div class="summary-card red">
            <div class="label">Returned by HR</div>
            <div class="value">@Model.ReturnedCount</div>
        </div>
        <div class="summary-card green">
            <div class="label">Completed</div>
            <div class="value">@Model.CompletedCount</div>
        </div>
    </div>

    @foreach (var deptGroup in Model.TeamRows.GroupBy(r => r.DeptName))
    {
        <div class="card" style="margin-bottom:20px;">
            <div class="card-header">@deptGroup.Key — @Model.EvalYear (@deptGroup.Count())</div>
            <div class="card-body" style="padding:0;">
                <div class="table-scroll">
                <table class="grid">
                    <thead><tr><th>Employee</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in deptGroup)
                        {
                            <tr>
                                <td>@r.EmpCode - @r.Name</td>
                                <td>
                                    @if (r.NeedsAttention)
                                    {
                                        <span class="status-chip"><span class="status-dot" style="background:var(--red);"></span>@r.Status</span>
                                    }
                                    else
                                    {
                                        @r.Status
                                    }
                                </td>
                                <td><a class="btn btn-secondary" asp-page="/PmForm/Index" asp-route-empcd="@r.EmpCode" asp-route-year="@Model.EvalYear">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    <div class="form-actions" style="margin-top:20px;">
        <a class="btn btn-primary" asp-page="/PmForm/Index">Go to PM Form</a>
        <a class="btn btn-secondary" asp-page="/PmFormSummary/Index">View Team Summary</a>
    </div>
}
else
{
    <div class="summary-cards">
        <div class="summary-card blue">
            <div class="label">Employees</div>
            <div class="value">@Model.EmployeeCount</div>
        </div>
        <div class="summary-card grey">
            <div class="label">Forms Generated (@Model.EvalYear)</div>
            <div class="value">@Model.FormsGeneratedCount</div>
        </div>
        <div class="summary-card @(Model.OverallCompletionPercent >= 75 ? "green" : Model.OverallCompletionPercent >= 40 ? "blue" : "red")">
            <div class="label">Overall Completion</div>
            <div class="value">@Model.OverallCompletionPercent%</div>
        </div>
    </div>

    <div class="card" style="margin-bottom:20px;">
        <div class="card-header">Form Status Breakdown</div>
        <div class="perf-metrics">
            <div class="perf-metric">
                <div class="label">Ready / Not Started</div>
                <div class="value">@Model.ReadyCount</div>
            </div>
            <div class="perf-metric">
                <div class="label">In Progress</div>
                <div class="value">@Model.InProgressCount</div>
            </div>
            <div class="perf-metric">
                <div class="label">Finalized</div>
                <div class="value">@Model.FinalizedCount</div>
            </div>
            <div class="perf-metric">
                <div class="label">Total</div>
                <div class="value">@Model.FormsGeneratedCount</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Department Completion, Progress &amp; Performance</div>
        <div class="card-body" style="padding:0;">
            @if (Model.DeptCompletion.Count == 0)
            {
                <p class="muted" style="margin:0;padding:16px;">No department data available. Employees must be assigned
                    to a department in Employee Master, matched to a Department Master record in Reference Master.</p>
            }
            else
            {
                <div class="table-scroll">
                <table class="grid">
                    <thead>
                        <tr>
                            <th>Department</th><th>Employees</th><th>Progress</th><th>Completion</th><th>Avg. Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.DeptCompletion)
                        {
                            <tr>
                                <td><strong>@d.Name</strong></td>
                                <td>@d.TotalEmployees</td>
                                <td>
                                    <div class="progress-outer" style="max-width:160px;">
                                        <div class="progress-inner" style="width:@(d.ProgressPercent)%;">@d.ProgressPercent%</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="progress-outer" style="max-width:160px;">
                                        <div class="progress-inner" style="width:@(d.CompletionPercent)%;">@d.CompletionPercent%</div>
                                    </div>
                                </td>
                                @if (d.FormCount == 0)
                                {
                                    <td class="muted">—</td>
                                }
                                else
                                {
                                    <td style="font-weight:700;color:@(d.AverageScore >= 90 ? "var(--green)" : d.AverageScore >= 70 ? "var(--amber)" : "var(--red)");">
                                        @d.AverageScore.ToString("F2")
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>

    <div class="form-actions" style="margin-top:20px;">
        <a class="btn btn-primary" asp-page="/PmFormSummary/Index">Open PM Form Summary</a>
        <a class="btn btn-secondary" asp-page="/Employees/Index">Employee Master</a>
        <a class="btn btn-secondary" asp-page="/Reports/Index">Reports</a>
    </div>
}

<div class="card" style="margin-top:20px;">
    <div class="card-header">Recent Activity</div>
    <div class="card-body">
        @if (Model.RecentActivity.Count == 0)
        {
            <p class="muted" style="margin:0;">No recent activity.</p>
        }
        else
        {
            @foreach (var a in Model.RecentActivity)
            {
                <div style="padding:9px 0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:12px;">
                    <span>@a.Text <span class="muted">— @a.By</span></span>
                    <span class="muted" style="white-space:nowrap;">@a.When.ToString("dd MMM yyyy HH:mm")</span>
                </div>
            }
        }
    </div>
</div>
