@page
@model PerformanceManagement.Web.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employee Master";
}
<div class="page-header">Employee Master</div>

<div class="card">
    <div class="card-header">Search</div>
    <div class="card-body">
        <form method="get">
            <div class="filters">
                <div>
                    <label for="empSearchQ">Search (code, name, username or email)</label>
                    <input type="text" id="empSearchQ" name="q" value="@Model.Q" placeholder="e.g. 1504, Alfahad, 0854, name@company.com" />
                </div>
                <div>
                    <label for="empSearchDept">Department</label>
                    <select name="dept" id="empSearchDept" onchange="this.form.submit()">
                        <option value="">All Departments</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Code" selected="@(d.Code == Model.Dept)">@d.NameEn</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="empSearchStatus">Active Status</label>
                    <select name="activeStatus" id="empSearchStatus" onchange="this.form.submit()">
                        <option value="active" selected="@(Model.ActiveStatus == "active")">Active only</option>
                        <option value="inactive" selected="@(Model.ActiveStatus == "inactive")">Terminated only</option>
                        <option value="all" selected="@(Model.ActiveStatus == "all")">All</option>
                    </select>
                </div>
                <div></div>
                <div style="display:flex;gap:8px;">
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (Model.IsHrAdmin)
                    {
                        <a class="btn btn-success" asp-page="Edit">＋ New Employee</a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-scroll">
<table class="grid">
    <thead>
        <tr>
            <th>Code</th><th>Name</th><th>Username</th><th>Department</th><th>Section</th><th>Designation</th>
            <th>Grade</th><th>Join Date</th><th>Direct Manager</th><th>Status</th><th>Source</th>
            @if (Model.IsHrAdmin) { <th></th> }
        </tr>
    </thead>
    <tbody>
    @if (Model.Rows.Count == 0)
    {
        <tr><td colspan="12" class="muted" style="text-align:center;padding:24px;">No employees match your search.</td></tr>
    }
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td>@r.E.EmpCode</td>
            <td><strong>@r.E.LatinName</strong>@(string.IsNullOrEmpty(r.E.ArabicName) ? "" : $" / {r.E.ArabicName}")</td>
            <td>@(r.UserName ?? "—")</td>
            <td>@r.DeptName</td>
            <td>@r.E.SectionCode</td>
            <td>@r.DesigName</td>
            <td>@r.E.Grade</td>
            <td>@r.E.JoinDate?.ToString("dd/MM/yyyy")</td>
            <td>@r.ManagerLabel</td>
            <td>@(r.E.IsActive ? "Active" : $"Terminated {r.E.TermDate:dd/MM/yyyy}")</td>
            <td class="muted">@r.E.Source</td>
            @if (Model.IsHrAdmin)
            {
                <td><a class="btn btn-secondary" style="padding:4px 12px;font-size:12px;" asp-page="Edit" asp-route-empcd="@r.E.EmpCode">Edit</a></td>
            }
        </tr>
    }
    </tbody>
</table>
</div>
<p class="muted">@Model.Rows.Count employees. Rows sourced from HDR_SNAPSHOT were synthesized from the
legacy pm_form_records export because no empmaster export exists (docs/data-migration-plan.md §2).</p>
