@page
@model PerformanceManagement.Web.Pages.Employees.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavEmployeeMaster"].Value;
}
<div class="page-header">@SharedLocalizer["NavEmployeeMaster"]</div>

<div class="card">
    <div class="card-header">@Localizer["SearchHeader"]</div>
    <div class="card-body">
        <form method="get">
            <div class="filters">
                <div>
                    <label for="empSearchQ">@Localizer["SearchFieldLabel"]</label>
                    <input type="text" id="empSearchQ" name="q" value="@Model.Q" placeholder="@Localizer["SearchPlaceholder"]" />
                </div>
                <div>
                    <label for="empSearchDept">@SharedLocalizer["Department"]</label>
                    <select name="dept" id="empSearchDept" data-searchable onchange="this.form.submit()">
                        <option value="">@SharedLocalizer["AllDepartments"]</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Code" selected="@(d.Code == Model.Dept)">@d.NameEn</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="empSearchStatus">@Localizer["ActiveStatusLabel"]</label>
                    <select name="activeStatus" id="empSearchStatus" onchange="this.form.submit()">
                        <option value="active" selected="@(Model.ActiveStatus == "active")">@Localizer["ActiveOnlyOption"]</option>
                        <option value="inactive" selected="@(Model.ActiveStatus == "inactive")">@Localizer["TerminatedOnlyOption"]</option>
                        <option value="all" selected="@(Model.ActiveStatus == "all")">@SharedLocalizer["All"]</option>
                    </select>
                </div>
                <div></div>
                <div style="display:flex;gap:8px;">
                    <button type="submit" class="btn btn-primary">@SharedLocalizer["Search"]</button>
                    @if (Model.IsHrAdmin)
                    {
                        <a class="btn btn-success" asp-page="Edit">@Localizer["NewEmployeeButton"]</a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-scroll">
<table class="grid">
    <thead>
        <tr>
            <th>@Localizer["CodeHeader"]</th><th>@SharedLocalizer["Name"]</th><th>@SharedLocalizer["Username"]</th><th>@SharedLocalizer["Department"]</th><th>@SharedLocalizer["Section"]</th><th>@SharedLocalizer["Designation"]</th>
            <th>@SharedLocalizer["Grade"]</th><th>@Localizer["JoinDateHeader"]</th><th>@SharedLocalizer["DirectManager"]</th><th>@SharedLocalizer["Status"]</th><th>@Localizer["SourceHeader"]</th>
            @if (Model.IsHrAdmin) { <th></th> }
        </tr>
    </thead>
    <tbody>
    @if (Model.Rows.Count == 0)
    {
        <tr><td colspan="12" class="muted" style="text-align:center;padding:24px;">@Localizer["NoEmployeesMatch"]</td></tr>
    }
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td>@r.E.EmpCode</td>
            <td><strong>@r.E.LatinName</strong>@(string.IsNullOrEmpty(r.E.ArabicName) ? "" : $" / {r.E.ArabicName}")</td>
            <td>@(r.UserName ?? "—")</td>
            <td>@r.DeptName</td>
            <td>@r.E.SectionCode</td>
            <td>@r.DesigName</td>
            <td>@r.E.Grade</td>
            <td>@r.E.JoinDate?.ToString("dd/MM/yyyy")</td>
            <td>@r.ManagerLabel</td>
            <td>@(r.E.IsActive ? SharedLocalizer["Active"].Value : string.Format(Localizer["TerminatedOn"].Value, r.E.TermDate!.Value))</td>
            <td class="muted">@r.E.Source</td>
            @if (Model.IsHrAdmin)
            {
                <td><a class="btn btn-secondary" style="padding:4px 12px;font-size:12px;" asp-page="Edit" asp-route-empcd="@r.E.EmpCode">@SharedLocalizer["Edit"]</a></td>
            }
        </tr>
    }
    </tbody>
</table>
</div>
<p class="muted">@Localizer["FooterNote", Model.Rows.Count]</p>
