@page
@model PerformanceManagement.Web.Pages.Jobs.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavScheduledJobs"].Value;
}
<div class="page-header">@SharedLocalizer["NavScheduledJobs"]</div>

<div class="table-scroll">
<table class="grid">
    <thead>
        <tr><th>@Localizer["ColJob"]</th><th>@SharedLocalizer["Status"]</th><th>@Localizer["ColNextRun"]</th><th>@Localizer["ColPreviousRun"]</th><th>@Localizer["ColDuration"]</th><th>@Localizer["ColResult"]</th><th></th></tr>
    </thead>
    <tbody>
    @if (Model.Jobs.Count == 0)
    {
        <tr><td colspan="7" class="muted" style="text-align:center;padding:24px;">@Localizer["NoJobsRegisteredMessage"]</td></tr>
    }
    @foreach (var j in Model.Jobs)
    {
        <tr>
            <td>
                <strong>@j.Name</strong>
                <div class="muted" style="font-size:12px;">@j.Description</div>
            </td>
            <td>
                @if (j.IsPaused)
                {
                    <span class="status-chip"><span class="status-dot" style="background:var(--red);"></span> @SharedLocalizer["Disabled"]</span>
                }
                else if (j.LastRun?.Status == "RUNNING")
                {
                    <span class="status-chip"><span class="status-dot" style="background:var(--amber);"></span> @Localizer["StatusRunning"]</span>
                }
                else if (j.LastRun?.Status == "FAILED")
                {
                    <span class="status-chip"><span class="status-dot" style="background:var(--red);"></span> @Localizer["StatusFailedLastRun"]</span>
                }
                else
                {
                    <span class="status-chip"><span class="status-dot"></span> @Localizer["StatusEnabledLabel"]</span>
                }
            </td>
            <td>@(j.NextFireUtc is { } next ? next.LocalDateTime.ToString("dd/MM/yyyy HH:mm") : "—")</td>
            <td>@(j.LastRun is null ? Localizer["NeverRunLabel"] : j.LastRun.StartedAt.ToString("dd/MM/yyyy HH:mm"))</td>
            <td>@(j.LastRun?.CompletedAt is { } done ? $"{(done - j.LastRun.StartedAt).TotalSeconds:F1}s" : "—")</td>
            <td style="max-width:280px;">@(j.LastRun?.ErrorMessage ?? j.LastRun?.ResultSummary ?? "—")</td>
            <td style="white-space:nowrap;">
                <form method="post" asp-page-handler="RunNow" asp-route-name="@j.Name" class="inline-form">
                    <button type="submit" class="btn btn-secondary btn-sm">@SharedLocalizer["RunNow"]</button>
                </form>
                @if (j.IsPaused)
                {
                    <form method="post" asp-page-handler="Resume" asp-route-name="@j.Name" class="inline-form">
                        <button type="submit" class="btn btn-success btn-sm">@SharedLocalizer["EnableAction"]</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Pause" asp-route-name="@j.Name" class="inline-form">
                        <button type="submit" class="btn btn-utility btn-sm">@SharedLocalizer["Disable"]</button>
                    </form>
                }
                <a class="btn btn-secondary btn-sm" asp-page="Index" asp-route-ViewLog="@j.Name">@SharedLocalizer["ViewLog"]</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ViewLog))
{
    <div class="card" style="margin-top:20px;">
        <div class="card-header">@Localizer["RecentRunsHeader", Model.ViewLog]</div>
        <div class="card-body">
            @if (Model.LogRuns.Count == 0)
            {
                <p class="muted" style="margin:0;">@Localizer["NoRunsRecordedMessage"]</p>
            }
            else
            {
                <div class="table-scroll">
                <table class="grid">
                    <thead><tr><th>@Localizer["ColStarted"]</th><th>@Localizer["ColCompleted"]</th><th>@SharedLocalizer["Status"]</th><th>@Localizer["ColResultError"]</th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.LogRuns)
                    {
                        <tr>
                            <td>@r.StartedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@(r.CompletedAt?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")</td>
                            <td>@r.Status</td>
                            <td>@(r.ErrorMessage ?? r.ResultSummary ?? "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>
}
