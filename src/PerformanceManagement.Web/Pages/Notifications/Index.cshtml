@page
@model PerformanceManagement.Web.Pages.Notifications.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavNotifications"].Value;
}
<div class="page-header">@SharedLocalizer["NavNotifications"]</div>

<div class="form-actions" style="margin-bottom:16px;">
    <form method="post" asp-page-handler="MarkAllRead" class="inline-form">
        <button type="submit" class="btn btn-secondary">@SharedLocalizer["MarkAllRead"]</button>
    </form>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card"><div class="card-body"><p class="muted" style="margin:0;">@SharedLocalizer["NoNotificationsYet"]</p></div></div>
}
else
{
    <div class="table-scroll">
    <table class="grid">
        <thead><tr><th></th><th>@Localizer["ColTitle"]</th><th>@Localizer["ColMessage"]</th><th>@Localizer["ColReceived"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var n in Model.Items)
        {
            <tr class="@(n.IsRead ? "" : "unread")">
                <td>@(n.IsRead ? "" : "●")</td>
                <td>
                    @if (!string.IsNullOrEmpty(n.Link))
                    {
                        <a href="@n.Link">@n.Title</a>
                    }
                    else
                    {
                        @n.Title
                    }
                </td>
                <td>@n.Message</td>
                <td>@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td style="white-space:nowrap;">
                    @if (!n.IsRead)
                    {
                        <form method="post" asp-page-handler="MarkRead" asp-route-id="@n.Id" class="inline-form">
                            <button type="submit" class="btn btn-secondary btn-sm">@SharedLocalizer["MarkRead"]</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Delete" asp-route-id="@n.Id" class="inline-form">
                        <button type="submit" class="btn btn-danger btn-sm">@SharedLocalizer["Delete"]</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
