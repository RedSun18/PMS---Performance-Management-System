@page
@model PerformanceManagement.Web.Pages.PmFormSummary.IndexModel
@{
    ViewData["Title"] = "PM Form Summary";
}
<div class="page-header">PM Form Summary — HR Tracking</div>

<div class="card">
    <div class="card-header">Filters</div>
    <div class="card-body">
        <form method="get">
            <div class="filters">
                <div>
                    <label for="summaryDept">Department</label>
                    <select name="dept" id="summaryDept" onchange="this.form.empcd.value='';this.form.submit()">
                        <option value="">All Departments</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Code" selected="@(d.Code == Model.Dept)">@d.NameEn</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="summaryEmpcd">Employee</label>
                    <select name="empcd" id="summaryEmpcd" onchange="this.form.submit()">
                        <option value="">All Employees</option>
                        @foreach (var (code, label) in Model.EmployeeOptions)
                        {
                            <option value="@code" selected="@(code == Model.Empcd)">@label</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="summaryYear">Evaluation Year</label>
                    <select name="year" id="summaryYear" onchange="this.form.submit()">
                        <option value="">All Years</option>
                        @foreach (var y in Model.YearOptions)
                        {
                            <option value="@y" selected="@(y.ToString() == Model.Year)">@y</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="summaryStatus">Status</label>
                    <select name="status" id="summaryStatus" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (var s in PmFormStatus.All)
                        {
                            <option value="@s" selected="@(s == Model.Status)">@PmFormStatus.DisplayName(s)</option>
                        }
                    </select>
                </div>
                <div><button type="submit" class="btn btn-primary">Apply</button></div>
            </div>
        </form>
    </div>
</div>

<h3 style="margin:14px 2px;">@Model.Title (@Model.Rows.Count forms)</h3>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-warn">No PM forms match the selected filters.</div>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>SRL. No</th><th>Employee</th><th>Department</th><th>Designation</th>
                <th>KPI Score %</th><th>Competency Score %</th><th>Overall Score %</th>
                <th>Rating Score</th><th>Rating</th><th>Status</th><th>Ref No</th>
                <th>Last Updated</th><th>View Form</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Srl</td>
                <td>@r.Employee</td>
                <td>@r.DeptName</td>
                <td>@r.Designation</td>
                <td>@r.KpiScore.ToString("0.00")</td>
                <td>@r.CompScore.ToString("0.00")</td>
                <td style="font-weight:700;color:@(r.OverallScore >= 90 ? "#15803d" : r.OverallScore >= 70 ? "#d97706" : "#dc2626");">@r.OverallScore.ToString("0.00")</td>
                <td>@r.RatingScore</td>
                <td><span class="rating-pill">@r.Rating</span></td>
                <td>@r.Status</td>
                <td>@r.RefNo</td>
                <td>@r.LastUpdated</td>
                <td><a class="btn btn-secondary" style="padding:4px 12px;font-size:12px;" target="_blank"
                       asp-page="/PmForm/Index" asp-route-empcd="@r.EmpCode">View</a></td>
            </tr>
        }
        </tbody>
    </table>
}
