@page
@model PerformanceManagement.Web.Pages.PmFormSummary.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavPmFormSummary"].Value;
}
<div class="page-header">@Localizer["PageHeader"]</div>

<div class="card">
    <div class="card-header">@Localizer["FiltersHeader"]</div>
    <div class="card-body">
        <form method="get">
            <div class="filters-6">
                <div>
                    <label for="summaryDept">@SharedLocalizer["Department"]</label>
                    <select name="dept" id="summaryDept" data-searchable onchange="this.form.empcd.value='';this.form.submit()">
                        <option value="">@SharedLocalizer["AllDepartments"]</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.Code" selected="@(d.Code == Model.Dept)">@d.NameEn</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="summaryEmpcd">@SharedLocalizer["Employee"]</label>
                    <select name="empcd" id="summaryEmpcd" data-searchable onchange="this.form.submit()">
                        <option value="">@SharedLocalizer["AllEmployees"]</option>
                        @foreach (var (code, label) in Model.EmployeeOptions)
                        {
                            <option value="@code" selected="@(code == Model.Empcd)">@label</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="summaryYear">@SharedLocalizer["ReviewYear"]</label>
                    <select name="year" id="summaryYear" onchange="this.form.submit()">
                        <option value="">@Localizer["AllYearsOption"]</option>
                        @foreach (var y in Model.YearOptions)
                        {
                            <option value="@y" selected="@(y.ToString() == Model.Year)">@y</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="summaryStatus">@SharedLocalizer["Status"]</label>
                    <select name="status" id="summaryStatus" onchange="this.form.submit()">
                        <option value="">@SharedLocalizer["AllStatuses"]</option>
                        @foreach (var s in PmFormStatus.All)
                        {
                            <option value="@s" selected="@(s == Model.Status)">@PmFormStatus.DisplayName(s)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="summaryManager">@SharedLocalizer["Manager"]</label>
                    <select name="manager" id="summaryManager" data-searchable onchange="this.form.submit()">
                        <option value="">@SharedLocalizer["AllManagers"]</option>
                        @foreach (var (code, label) in Model.ManagerOptions)
                        {
                            <option value="@code" selected="@(code == Model.Manager)">@label</option>
                        }
                    </select>
                </div>
                <div><button type="submit" class="btn btn-primary">@SharedLocalizer["Apply"]</button></div>
            </div>
        </form>
    </div>
</div>

<h3 style="margin:14px 2px;">@Model.Title @Localizer["FormsCountSuffix", Model.TotalCount]</h3>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-warn">@Localizer["NoFormsMatch"]</div>
}
else
{
    <div class="table-scroll">
    <table class="grid">
        <thead>
            <tr>
                <th>@Localizer["SrlNoHeader"]</th><th>@SharedLocalizer["Employee"]</th><th>@SharedLocalizer["Department"]</th><th>@SharedLocalizer["Designation"]</th>
                <th>@Localizer["KpiScoreHeader"]</th><th>@Localizer["CompScoreHeader"]</th><th>@Localizer["OverallScoreHeader"]</th>
                <th>@Localizer["RatingScoreHeader"]</th><th>@SharedLocalizer["Rating"]</th><th>@SharedLocalizer["Status"]</th><th>@Localizer["RefNoHeader"]</th>
                <th>@Localizer["LastUpdatedHeader"]</th><th>@Localizer["ViewFormHeader"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Srl</td>
                <td>@r.Employee</td>
                <td>@r.DeptName</td>
                <td>@r.Designation</td>
                <td>@r.KpiScore.ToString("0.00")</td>
                <td>@r.CompScore.ToString("0.00")</td>
                <td style="font-weight:700;color:@(r.OverallScore >= 90 ? "var(--green)" : r.OverallScore >= 70 ? "var(--amber-soft)" : "var(--red)");">@r.OverallScore.ToString("0.00")</td>
                <td>@r.RatingScore</td>
                <td><span class="rating-pill">@r.Rating</span></td>
                <td>@r.Status</td>
                <td>@r.RefNo</td>
                <td>@r.LastUpdated</td>
                <td><a class="btn btn-secondary btn-sm" target="_blank"
                       asp-page="/PmForm/Index" asp-route-empcd="@r.EmpCode">@SharedLocalizer["View"]</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="form-actions" style="margin-top:14px;">
            @if (Model.PageNumber > 1)
            {
                <a class="btn btn-secondary" asp-all-route-data="Model.FilterRouteData" asp-route-pageNum="@(Model.PageNumber - 1)">@Localizer["PreviousPageButton"]</a>
            }
            <span class="muted">@Localizer["PageIndicator", Model.PageNumber, Model.TotalPages]</span>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="btn btn-secondary" asp-all-route-data="Model.FilterRouteData" asp-route-pageNum="@(Model.PageNumber + 1)">@Localizer["NextPageButton"]</a>
            }
        </div>
    }
}
