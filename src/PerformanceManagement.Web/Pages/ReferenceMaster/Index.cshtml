@page
@model PerformanceManagement.Web.Pages.ReferenceMaster.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavReferenceMaster"].Value;

    // Perspective / competency-type / status labels are re-derived here from their short
    // codes (F/C/I/L, B/T, A/I) rather than read from the stored *Desc columns, so the
    // displayed label always follows the current UI culture — the stored description is a
    // legacy-style cache column written in English at save time (see Index.cshtml.cs) and is
    // not itself re-translated.
    string PerspectiveLabel(string code) => code.Trim() switch
    {
        "F" => Localizer["PerspectiveFinancial"].Value,
        "C" => Localizer["PerspectiveCustomer"].Value,
        "I" => Localizer["PerspectiveInternal"].Value,
        "L" => Localizer["PerspectiveLearning"].Value,
        _ => code
    };
    string CompTypeLabel(string code) => code.Trim() == "T" ? Localizer["TechnicalOption"].Value : Localizer["BehavioralOption"].Value;
}
<div class="page-header">@Localizer["PageHeader"]</div>

<div class="tabs">
    <a href="?tab=kpi" class="@(Model.Tab == "kpi" ? "active" : "")">@SharedLocalizer["NavKpiMaster"]</a>
    <a href="?tab=comp" class="@(Model.Tab == "comp" ? "active" : "")">@SharedLocalizer["NavCompetencyMaster"]</a>
    <a href="?tab=dept" class="@(Model.Tab == "dept" ? "active" : "")">@Localizer["TabDepartments"]</a>
    <a href="?tab=ref" class="@(Model.Tab == "ref" ? "active" : "")">@Localizer["TabJobFamiliesRatingScales"]</a>
</div>

@if (Model.Tab == "kpi")
{
    var k = Model.KpiEdit;
    <div class="card">
        <div class="card-header">@(k is null ? Localizer["AddKpiHeader", Model.NextKpiId] : Localizer["EditKpiHeader", k.KpiId])</div>
        <div class="card-body">
            <form method="post" asp-page-handler="SaveKpi">
                <input type="hidden" name="input.KpiId" value="@(k?.KpiId ?? Model.NextKpiId)" />
                <div class="grid-4" style="margin-bottom:12px;">
                    <div><label for="kpiCodeRO">@Localizer["KpiCodeLabel"]</label><input type="text" id="kpiCodeRO" value="@(k?.KpiId ?? Model.NextKpiId)" readonly /></div>
                    <div>
                        <label for="kpiFormPerspective">@Localizer["PerspectiveLabel"]</label>
                        <select name="input.Perspective" id="kpiFormPerspective">
                            <option value="F" selected="@(k?.Perspective.Trim() == "F")">@Localizer["PerspectiveFinancial"]</option>
                            <option value="C" selected="@(k?.Perspective.Trim() == "C")">@Localizer["PerspectiveCustomer"]</option>
                            <option value="I" selected="@(k?.Perspective.Trim() == "I")">@Localizer["PerspectiveInternal"]</option>
                            <option value="L" selected="@(k?.Perspective.Trim() == "L")">@Localizer["PerspectiveLearning"]</option>
                        </select>
                    </div>
                    <div>
                        <label for="kpiDeptCsv">@Localizer["DeptCsvLabel"]</label>
                        <input type="text" id="kpiDeptCsv" name="input.DeptCsv" value="@(k?.DeptCsv ?? "*")" />
                    </div>
                    <div>
                        <label for="kpiStatus">@SharedLocalizer["Status"]</label>
                        <select name="input.Status" id="kpiStatus">
                            <option value="A" selected="@(k?.Status != "I")">@SharedLocalizer["Active"]</option>
                            <option value="I" selected="@(k?.Status == "I")">@SharedLocalizer["Inactive"]</option>
                        </select>
                    </div>
                </div>
                <div class="grid-2" style="margin-bottom:12px;">
                    <div><label for="kpiNameEn">@Localizer["KpiNameEnLabel"]</label><input type="text" id="kpiNameEn" name="input.Name" value="@k?.Name" maxlength="100" /></div>
                    <div><label for="kpiNameAr">@Localizer["KpiNameArLabel"]</label><input type="text" id="kpiNameAr" name="input.NameAr" value="@k?.NameAr" maxlength="100" dir="rtl" /></div>
                </div>
                <div class="grid-2" style="margin-bottom:12px;">
                    <div><label for="kpiDescEn">@Localizer["PurposeDefinitionEnLabel"]</label><textarea id="kpiDescEn" name="input.Description" rows="2">@k?.Description</textarea></div>
                    <div><label for="kpiDescAr">@Localizer["PurposeDefinitionArLabel"]</label><textarea id="kpiDescAr" name="input.DescriptionAr" rows="2" dir="rtl">@k?.DescriptionAr</textarea></div>
                </div>
                <div class="grid-2" style="margin-bottom:12px;">
                    <div><label for="kpiFormulaEn">@Localizer["FormulaMetricEnLabel"]</label><textarea id="kpiFormulaEn" name="input.Formula" rows="2">@k?.Formula</textarea></div>
                    <div><label for="kpiFormulaAr">@Localizer["FormulaMetricArLabel"]</label><textarea id="kpiFormulaAr" name="input.FormulaAr" rows="2" dir="rtl">@k?.FormulaAr</textarea></div>
                </div>
                <div class="grid-4" style="margin-bottom:14px;">
                    <div><label for="kpiMinWeight">@Localizer["MinWeightPercentLabel"]</label><input type="number" id="kpiMinWeight" name="input.MinWeight" value="@(k?.MinWeight ?? 10)" min="0" max="100" /></div>
                    <div><label for="kpiMaxWeight">@Localizer["MaxWeightPercentLabel"]</label><input type="number" id="kpiMaxWeight" name="input.MaxWeight" value="@(k?.MaxWeight ?? 25)" min="0" max="100" /></div>
                    <div style="grid-column:span 2;"><label for="kpiRemarks">@SharedLocalizer["Remarks"]</label><input type="text" id="kpiRemarks" name="input.Remarks" value="@k?.Remarks" /></div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@(k is null ? Localizer["SaveKpiButton"] : Localizer["UpdateKpiButton"])</button>
                    <a class="btn btn-secondary" href="?tab=kpi">@SharedLocalizer["Clear"]</a>
                </div>
            </form>
        </div>
    </div>

    <form method="get" style="margin-bottom:10px;">
        <input type="hidden" name="tab" value="kpi" />
        <div class="filters">
            <div>
                <label for="kpiFilterQuery">@Localizer["SearchCodeOrNameLabel"]</label>
                <input type="text" name="kpiQuery" id="kpiFilterQuery" value="@Model.KpiQuery" placeholder="@Localizer["KpiSearchPlaceholder"]" />
            </div>
            <div>
                <label for="kpiFilterPerspective">@Localizer["PerspectiveLabel"]</label>
                <select name="perspective" id="kpiFilterPerspective" onchange="this.form.submit()">
                    <option value="">@SharedLocalizer["All"]</option>
                    <option value="F" selected="@(Model.Perspective == "F")">@Localizer["PerspectiveFinancial"]</option>
                    <option value="C" selected="@(Model.Perspective == "C")">@Localizer["PerspectiveCustomer"]</option>
                    <option value="I" selected="@(Model.Perspective == "I")">@Localizer["PerspectiveInternal"]</option>
                    <option value="L" selected="@(Model.Perspective == "L")">@Localizer["PerspectiveLearning"]</option>
                </select>
            </div>
            <div>
                <label for="kpiFilterDept">@SharedLocalizer["Department"]</label>
                <select name="deptFilter" id="kpiFilterDept" data-searchable onchange="this.form.submit()">
                    <option value="">@SharedLocalizer["All"]</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.Code" selected="@(d.Code == Model.DeptFilter)">@d.NameEn</option>
                    }
                </select>
            </div>
            <div style="align-self:end;"><button type="submit" class="btn btn-secondary">@SharedLocalizer["Search"]</button></div>
            <div></div>
        </div>
    </form>

    <div class="table-scroll">
    <table class="grid">
        <thead><tr><th>@Localizer["ColCode"]</th><th>@SharedLocalizer["Name"]</th><th>@Localizer["PerspectiveLabel"]</th><th>@Localizer["ColDepartments"]</th><th>@Localizer["ColWeightRange"]</th><th>@SharedLocalizer["Status"]</th><th>@Localizer["ColModified"]</th><th></th></tr></thead>
        <tbody>
        @if (Model.Kpis.Count == 0)
        {
            <tr><td colspan="8" class="muted" style="text-align:center;padding:24px;">@Localizer["NoKpisFoundMessage"]</td></tr>
        }
        @foreach (var row in Model.Kpis)
        {
            <tr>
                <td>@row.KpiId</td>
                <td><strong>@row.Name</strong>@(string.IsNullOrEmpty(row.NameAr) ? "" : $" / {row.NameAr}")</td>
                <td>@PerspectiveLabel(row.Perspective)</td>
                <td>@row.DeptCsv</td>
                <td>@row.MinWeight–@row.MaxWeight%</td>
                <td>@(row.Status == "A" ? SharedLocalizer["Active"] : SharedLocalizer["Inactive"])</td>
                <td>@row.ModifiedDate?.ToString("dd/MM/yyyy") @row.ModifiedBy</td>
                <td><a class="btn btn-secondary" style="padding:4px 12px;font-size:12px;" href="?tab=kpi&editId=@row.KpiId">@SharedLocalizer["Edit"]</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <p class="muted">@Localizer["KpiCountSummary", Model.Kpis.Count]</p>
}
else if (Model.Tab == "comp")
{
    var c = Model.CompEdit;
    <div class="card">
        <div class="card-header">@(c is null ? Localizer["AddCompetencyHeader", Model.NextCompId] : Localizer["EditCompetencyHeader", c.CompId])</div>
        <div class="card-body">
            <form method="post" asp-page-handler="SaveComp">
                <input type="hidden" name="input.CompId" value="@(c?.CompId ?? Model.NextCompId)" />
                <div class="grid-4" style="margin-bottom:12px;">
                    <div><label for="compCodeRO">@Localizer["CompetencyCodeLabel"]</label><input type="text" id="compCodeRO" value="@(c?.CompId ?? Model.NextCompId)" readonly /></div>
                    <div>
                        <label for="compFormType">@SharedLocalizer["Type"]</label>
                        <select name="input.CompType" id="compFormType">
                            <option value="B" selected="@(c?.CompType.Trim() == "B")">@Localizer["BehavioralOption"]</option>
                            <option value="T" selected="@(c?.CompType.Trim() == "T")">@Localizer["TechnicalOption"]</option>
                        </select>
                    </div>
                    <div>
                        <label for="compDeptCsv">@Localizer["DeptCsvLabel"]</label>
                        <input type="text" id="compDeptCsv" name="input.DeptCsv" value="@(c?.DeptCsv ?? "*")" />
                    </div>
                    <div>
                        <label for="compStatus">@SharedLocalizer["Status"]</label>
                        <select name="input.Status" id="compStatus">
                            <option value="A" selected="@(c?.Status != "I")">@SharedLocalizer["Active"]</option>
                            <option value="I" selected="@(c?.Status == "I")">@SharedLocalizer["Inactive"]</option>
                        </select>
                    </div>
                </div>
                <div class="grid-2" style="margin-bottom:12px;">
                    <div><label for="compNameEn">@Localizer["NameEnLabel"]</label><input type="text" id="compNameEn" name="input.Name" value="@c?.Name" maxlength="100" /></div>
                    <div><label for="compNameAr">@Localizer["NameArLabel"]</label><input type="text" id="compNameAr" name="input.NameAr" value="@c?.NameAr" maxlength="100" dir="rtl" /></div>
                </div>
                <div class="grid-2" style="margin-bottom:12px;">
                    <div><label for="compDescEn">@Localizer["DescriptionEnLabel"]</label><textarea id="compDescEn" name="input.Description" rows="2">@c?.Description</textarea></div>
                    <div><label for="compDescAr">@Localizer["DescriptionArLabel"]</label><textarea id="compDescAr" name="input.DescriptionAr" rows="2" dir="rtl">@c?.DescriptionAr</textarea></div>
                </div>
                <div class="grid-4" style="margin-bottom:14px;">
                    <div><label for="compMinWeight">@Localizer["MinWeightPercentLabel"]</label><input type="number" id="compMinWeight" name="input.MinWeight" value="@(c?.MinWeight ?? 10)" min="0" max="100" /></div>
                    <div><label for="compMaxWeight">@Localizer["MaxWeightPercentLabel"]</label><input type="number" id="compMaxWeight" name="input.MaxWeight" value="@(c?.MaxWeight ?? 20)" min="0" max="100" /></div>
                    <div style="grid-column:span 2;"><label for="compRemarks">@SharedLocalizer["Remarks"]</label><input type="text" id="compRemarks" name="input.Remarks" value="@c?.Remarks" /></div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@(c is null ? Localizer["SaveCompetencyButton"] : Localizer["UpdateCompetencyButton"])</button>
                    <a class="btn btn-secondary" href="?tab=comp">@SharedLocalizer["Clear"]</a>
                </div>
            </form>
        </div>
    </div>

    <form method="get" style="margin-bottom:10px;">
        <input type="hidden" name="tab" value="comp" />
        <div class="filters">
            <div>
                <label for="compFilterQuery">@Localizer["SearchCodeOrNameLabel"]</label>
                <input type="text" name="compQuery" id="compFilterQuery" value="@Model.CompQuery" placeholder="@Localizer["CompSearchPlaceholder"]" />
            </div>
            <div>
                <label for="compFilterType">@SharedLocalizer["Type"]</label>
                <select name="compType" id="compFilterType" onchange="this.form.submit()">
                    <option value="">@SharedLocalizer["All"]</option>
                    <option value="B" selected="@(Model.CompType == "B")">@Localizer["BehavioralOption"]</option>
                    <option value="T" selected="@(Model.CompType == "T")">@Localizer["TechnicalOption"]</option>
                </select>
            </div>
            <div style="align-self:end;"><button type="submit" class="btn btn-secondary">@SharedLocalizer["Search"]</button></div>
            <div></div><div></div>
        </div>
    </form>

    <div class="table-scroll">
    <table class="grid">
        <thead><tr><th>@Localizer["ColCode"]</th><th>@SharedLocalizer["Name"]</th><th>@SharedLocalizer["Type"]</th><th>@SharedLocalizer["Description"]</th><th>@Localizer["ColWeightRange"]</th><th>@SharedLocalizer["Status"]</th><th></th></tr></thead>
        <tbody>
        @if (Model.Comps.Count == 0)
        {
            <tr><td colspan="7" class="muted" style="text-align:center;padding:24px;">@Localizer["NoCompetenciesFoundMessage"]</td></tr>
        }
        @foreach (var row in Model.Comps)
        {
            <tr>
                <td>@row.CompId</td>
                <td><strong>@row.Name</strong>@(string.IsNullOrEmpty(row.NameAr) ? "" : $" / {row.NameAr}")</td>
                <td>@CompTypeLabel(row.CompType)</td>
                <td>@row.Description</td>
                <td>@row.MinWeight–@row.MaxWeight%</td>
                <td>@(row.Status == "A" ? SharedLocalizer["Active"] : SharedLocalizer["Inactive"])</td>
                <td><a class="btn btn-secondary" style="padding:4px 12px;font-size:12px;" href="?tab=comp&editId=@row.CompId">@SharedLocalizer["Edit"]</a></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <p class="muted">@Localizer["CompetencyCountSummary", Model.Comps.Count]</p>
}
else if (Model.Tab == "dept")
{
    var d = Model.DeptEdit;
    <div class="card">
        <div class="card-header">@(d is null ? Localizer["AddDepartmentHeader"] : Localizer["EditDepartmentHeader", d.Code])</div>
        <div class="card-body">
            <form method="post" asp-page-handler="SaveDepartment">
                <input type="hidden" name="isNew" value="@(d is null ? "true" : "false")" />
                <div class="grid-3" style="margin-bottom:12px;">
                    <div>
                        <label for="deptCode">@Localizer["DepartmentCodeLabel"]</label>
                        <input type="text" id="deptCode" name="code" value="@d?.Code" maxlength="10" readonly="@(d is not null)" />
                    </div>
                    <div>
                        <label for="deptName">@Localizer["DepartmentNameLabel"]</label>
                        <input type="text" id="deptName" name="nameEn" value="@d?.NameEn" maxlength="100" />
                    </div>
                    <div>
                        <label style="text-transform:none;">
                            <input type="checkbox" name="isActive" value="true" style="width:auto;" checked="@(d?.IsActive ?? true)" /> @SharedLocalizer["Active"]
                        </label>
                    </div>
                </div>
                <div style="margin-bottom:14px;">
                    <label for="deptDescription">@SharedLocalizer["Description"]</label><textarea id="deptDescription" name="description" rows="2">@d?.Description</textarea>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@(d is null ? Localizer["CreateDepartmentButton"] : Localizer["SaveChangesButton"])</button>
                    <a class="btn btn-secondary" href="?tab=dept">@SharedLocalizer["Clear"]</a>
                </div>
            </form>
        </div>
    </div>

    <form method="get" style="margin-bottom:10px;">
        <input type="hidden" name="tab" value="dept" />
        <div class="filters">
            <div>
                <label for="deptFilterQuery">@Localizer["SearchCodeNameDescLabel"]</label>
                <input type="text" name="deptQuery" id="deptFilterQuery" value="@Model.DeptQuery" placeholder="@Localizer["DeptSearchPlaceholder"]" />
            </div>
            <div style="align-self:end;"><button type="submit" class="btn btn-secondary">@SharedLocalizer["Search"]</button></div>
            <div></div><div></div><div></div>
        </div>
    </form>

    <div class="table-scroll">
    <table class="grid">
        <thead><tr><th>@Localizer["ColCode"]</th><th>@SharedLocalizer["Name"]</th><th>@SharedLocalizer["Description"]</th><th>@SharedLocalizer["Status"]</th><th></th></tr></thead>
        <tbody>
        @if (Model.DeptRows.Count == 0)
        {
            <tr><td colspan="5" class="muted" style="text-align:center;padding:24px;">@Localizer["NoDepartmentsFoundMessage"]</td></tr>
        }
        @foreach (var row in Model.DeptRows)
        {
            <tr>
                <td>@row.Code</td>
                <td><strong>@row.NameEn</strong></td>
                <td>@row.Description</td>
                <td>
                    <span class="status-chip">
                        <span class="status-dot" style="background:@(row.IsActive ? "var(--green)" : "var(--text-muted)");"></span>
                        @(row.IsActive ? SharedLocalizer["Active"] : SharedLocalizer["Disabled"])
                    </span>
                </td>
                <td style="display:flex;gap:6px;">
                    <a class="btn btn-secondary" style="padding:4px 12px;font-size:12px;" href="?tab=dept&deptEditCode=@row.Code">@SharedLocalizer["Edit"]</a>
                    <form method="post" asp-page-handler="ToggleDepartment" class="inline-form">
                        <input type="hidden" name="code" value="@row.Code" />
                        <button type="submit" class="btn btn-secondary" style="padding:4px 12px;font-size:12px;"
                                onclick="return confirm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(row.IsActive ? string.Format(Localizer["DisableConfirm"].Value, row.NameEn) : string.Format(Localizer["EnableConfirm"].Value, row.NameEn))));">
                            @(row.IsActive ? SharedLocalizer["Disable"] : SharedLocalizer["Enable"])
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <p class="muted">@Localizer["DepartmentsFooterNote", Model.DeptRows.Count]</p>
}
else
{
    <div class="card">
        <div class="card-header">@Localizer["JobFamiliesHeader"]</div>
        <div class="card-body">
            <div class="table-scroll">
            <table class="grid">
                <thead><tr><th>@Localizer["ColCode"]</th><th>@SharedLocalizer["Name"]</th><th>@Localizer["ColGrades"]</th><th>@Localizer["ColKpiWeightPercent"]</th><th>@Localizer["ColCompWeightPercent"]</th><th></th></tr></thead>
                <tbody>
                @foreach (var j in Model.JobFamilies)
                {
                    <tr>
                        <form method="post" asp-page-handler="SaveJobFamily">
                            <td>@j.Code<input type="hidden" name="code" value="@j.Code" /></td>
                            <td><input type="text" name="nameEn" aria-label="@Localizer["NameForJobFamilyAriaLabel", j.Code]" value="@j.NameEn" /></td>
                            <td><input type="text" name="gradesCsv" aria-label="@Localizer["GradesForJobFamilyAriaLabel", j.Code]" value="@j.GradesCsv" style="max-width:120px;" /></td>
                            <td><input type="number" name="kpiWeight" aria-label="@Localizer["KpiWeightForJobFamilyAriaLabel", j.Code]" value="@j.KpiWeight" min="0" max="100" style="max-width:90px;" /></td>
                            <td><input type="number" name="compWeight" aria-label="@Localizer["CompWeightForJobFamilyAriaLabel", j.Code]" value="@j.CompWeight" min="0" max="100" style="max-width:90px;" /></td>
                            <td><button type="submit" class="btn btn-secondary" style="padding:4px 12px;font-size:12px;">@SharedLocalizer["Save"]</button></td>
                        </form>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">@Localizer["RatingScalesHeader"]</div>
        <div class="card-body">
            <div class="table-scroll">
            <table class="grid">
                <thead><tr><th>@Localizer["ColCode"]</th><th>@Localizer["ColRatingEn"]</th><th>@Localizer["ColRatingAr"]</th><th>@Localizer["ColScoreRange"]</th><th>@SharedLocalizer["Remarks"]</th></tr></thead>
                <tbody>
                @foreach (var r in Model.RatingScales)
                {
                    <tr>
                        <td>@r.Code</td>
                        <td><strong>@r.NameEn</strong></td>
                        <td dir="rtl">@r.NameAr</td>
                        <td>@r.MinScore–@r.MaxScore</td>
                        <td>@r.Remarks</td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
            <p class="muted">@Localizer["RatingScalesFooterNote"]</p>
        </div>
    </div>
}
