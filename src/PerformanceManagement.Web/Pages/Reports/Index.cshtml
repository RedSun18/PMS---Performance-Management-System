@page
@model PerformanceManagement.Web.Pages.Reports.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavReports"].Value;
}
<div class="page-header">@SharedLocalizer["NavReports"]</div>

@if (Model.ReportError is not null) { <div class="alert alert-error">@Model.ReportError</div> }

<div class="card" style="margin-bottom:20px;">
    <div class="card-header">@Localizer["EmployeePerformanceReportHeader"]</div>
    <div class="card-body">
        <p class="muted" style="margin-top:0;">@Localizer["EmployeeReportDescription"]</p>
        <form method="get">
            <div class="filters">
                <div class="filter-wide">
                    <label for="repEmpcd">@SharedLocalizer["Employee"]</label>
                    <select name="empcd" id="repEmpcd" data-searchable required>
                        <option value="">@Localizer["SelectPlaceholderFormat", SharedLocalizer["Employee"].Value]</option>
                        @foreach (var (code, label) in Model.EmployeeOptions)
                        {
                            <option value="@code">@label</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="repEmpYear">@SharedLocalizer["ReviewYear"]</label>
                    <select name="year" id="repEmpYear">
                        @foreach (var y in Model.YearOptions)
                        {
                            <option value="@y" selected="@(y == Model.DefaultYear)">@y</option>
                        }
                    </select>
                </div>
                <div></div>
                <div style="display:flex;gap:8px;">
                    <button type="submit" name="handler" value="EmployeePdf" class="btn btn-primary">@Localizer["ExportPdfButton"]</button>
                    <button type="submit" name="handler" value="EmployeeExcel" class="btn btn-secondary">@Localizer["ExportExcelButton"]</button>
                </div>
            </div>
        </form>
    </div>
</div>

