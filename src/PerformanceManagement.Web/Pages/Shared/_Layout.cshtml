@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject SettingsService Settings
@inject NotificationService Notifications
@inject IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    var branding = await Settings.GetBrandingSettingsAsync();
    var general = await Settings.GetGeneralSettingsAsync();
    // The environment's own company name (e.g. a Demo/customer deployment) takes precedence
    // over the generic product name — same fallback chain used by report/email headers and
    // the login page, so the brand shown is consistent everywhere in the app.
    var appName = !string.IsNullOrWhiteSpace(general.CompanyName) ? general.CompanyName
        : !string.IsNullOrWhiteSpace(general.ApplicationName) ? general.ApplicationName
        : "Performance Management System";

    // Global Language Selector (Phase 10 Part 8) — current UI culture drives both which link
    // is highlighted and the page's text direction (Part 9: RTL support).
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture == "ar";
    var currentPath = Context.Request.Path + Context.Request.QueryString;

    // Single source of truth for "is the sidebar/topnav chrome shown" — every layout region
    // (sidebar presence, .main-area's reserved margin, notification bell) reads this one flag
    // instead of repeating the User.Identity check, so they can never drift out of sync.
    var hasSidebar = User.Identity?.IsAuthenticated == true;

    var unreadCount = 0;
    var recentNotifications = new List<Notification>();
    if (hasSidebar)
    {
        unreadCount = await Notifications.UnreadCountAsync(User.Identity!.Name ?? "");
        recentNotifications = await Notifications.GetRecentAsync(User.Identity!.Name ?? "");
    }

    // Standard flash-message keys used by [TempData] Message/ErrorMessage properties across
    // the app (Users, Departments, Settings, Jobs, PM Form, …) — read once here so every page
    // gets a toast for free instead of its own static <div class="alert"> after a redirect.
    var toastSuccess = TempData["Message"] as string;
    var toastError = TempData["ErrorMessage"] as string;
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? appName : $"{ViewData["Title"]} — {appName}")</title>
    <link rel="icon" type="image/svg+xml" href="@(string.IsNullOrEmpty(branding.CompanyLogoPath) ? "/favicon.svg" : branding.CompanyLogoPath)" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (branding.PrimaryColorHex is not null || branding.SecondaryColorHex is not null)
    {
        <style>
            :root {
                @if (branding.PrimaryColorHex is not null)
                {
                    @:--navy: @branding.PrimaryColorHex;
                }
                @if (branding.SecondaryColorHex is not null)
                {
                    @:--accent: @branding.SecondaryColorHex;
                }
            }
        </style>
    }
</head>
<body data-no-results-text="@SharedLocalizer["NoResultsFound"]">
    <a class="skip-link" href="#main-content">@SharedLocalizer["SkipToMainContent"]</a>
    <div class="layout-container @(hasSidebar ? "" : "no-sidebar")">
        <!-- Sidebar -->
        @if (hasSidebar)
        {
            <aside class="sidebar" id="sidebar">
                <nav class="sidebar-nav" aria-label="@SharedLocalizer["NavMainNavigation"]">
                    <a asp-page="/Dashboard/Index" class="sidebar-link">🏠 @SharedLocalizer["Dashboard"]</a>
                    <a asp-page="/PmForm/Index" class="sidebar-link">📋 @SharedLocalizer["NavPmForm"]</a>
                    @if ((bool?)ViewData["IsHrAdmin"] == true || (bool?)ViewData["IsViewer"] == true)
                    {
                        <a asp-page="/PmFormSummary/Index" class="sidebar-link">📊 @SharedLocalizer["NavPmFormSummary"]</a>
                        <a asp-page="/Employees/Index" class="sidebar-link">👥 @SharedLocalizer["NavEmployeeMaster"]</a>
                        <a asp-page="/ReferenceMaster/Index" asp-route-tab="kpi" class="sidebar-link">🎯 @SharedLocalizer["NavKpiMaster"]</a>
                        <a asp-page="/ReferenceMaster/Index" asp-route-tab="comp" class="sidebar-link">✓ @SharedLocalizer["NavCompetencyMaster"]</a>
                        <a asp-page="/ReferenceMaster/Index" asp-route-tab="ref" class="sidebar-link">📚 @SharedLocalizer["NavReferenceMaster"]</a>
                    }
                    @if ((bool?)ViewData["IsHrAdmin"] == true)
                    {
                        <hr class="sidebar-divider" />
                        <a asp-page="/Reports/Index" class="sidebar-link">🧾 @SharedLocalizer["NavReports"]</a>
                        <a asp-page="/Users/Index" class="sidebar-link">👤 @SharedLocalizer["NavUserManagement"]</a>
                        <a asp-page="/Admin/LoginAs" class="sidebar-link">🔐 @SharedLocalizer["NavLoginAs"]</a>
                        <a asp-page="/Jobs/Index" class="sidebar-link">⏱️ @SharedLocalizer["NavScheduledJobs"]</a>
                        <a asp-page="/WorkflowAdmin/Index" class="sidebar-link">🔀 @SharedLocalizer["NavWorkflowAdministration"]</a>
                        <a asp-page="/Settings/Index" class="sidebar-link">⚙️ @SharedLocalizer["NavSystemSettings"]</a>
                    }
                </nav>
            </aside>
        }
        
        <!-- Main content area -->
        <div class="main-area">
            <header class="topnav">
                @if (hasSidebar)
                {
                    <button class="sidebar-toggle" id="sidebarToggle" aria-label="@SharedLocalizer["ToggleSidebar"]">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                }
                <a class="topnav-brand" asp-page="/Dashboard/Index" style="text-decoration:none;color:inherit;display:flex;align-items:center;gap:10px;">
                    @if (!string.IsNullOrEmpty(branding.CompanyLogoPath))
                    {
                        <img src="@branding.CompanyLogoPath" alt="@appName logo" style="height:28px;max-width:160px;object-fit:contain;" />
                    }
                    @appName
                </a>
                <div class="topnav-user">
                    @if (general.LanguageSelectionEnabled)
                    {
                        <div class="lang-switch-inline">
                            <a href="/Culture/SetLanguage?culture=en&returnUrl=@Uri.EscapeDataString(currentPath)" class="@(isRtl ? "" : "active")">EN</a>
                            <a href="/Culture/SetLanguage?culture=ar&returnUrl=@Uri.EscapeDataString(currentPath)" class="@(isRtl ? "active" : "")">عربي</a>
                        </div>
                    }
                    @if (hasSidebar)
                    {
                        <div class="notif-bell-wrap">
                            <button type="button" class="notif-bell" id="notifBellBtn" aria-label="@SharedLocalizer["NavNotifications"]" aria-haspopup="true" aria-expanded="false">
                                🔔
                                @if (unreadCount > 0)
                                {
                                    <span class="notif-badge">@(unreadCount > 99 ? "99+" : unreadCount.ToString())</span>
                                }
                            </button>
                            <div class="notif-dropdown" id="notifDropdown" role="region" aria-label="@SharedLocalizer["NavNotifications"]">
                                <div class="notif-dropdown-header">
                                    <strong>@SharedLocalizer["NavNotifications"]</strong>
                                    <form method="post" asp-page="/Notifications/Index" asp-page-handler="MarkAllRead" class="inline-form">
                                        <button type="submit" class="btn btn-link" style="font-size:12px;padding:2px 6px;">@SharedLocalizer["MarkAllRead"]</button>
                                    </form>
                                </div>
                                @if (recentNotifications.Count == 0)
                                {
                                    <p class="muted" style="padding:14px;margin:0;">@SharedLocalizer["NoNotificationsYet"]</p>
                                }
                                else
                                {
                                    foreach (var n in recentNotifications)
                                    {
                                        <a class="notif-item @(n.IsRead ? "" : "unread")" href="@(n.Link ?? "/Notifications/Index")">
                                            <div class="notif-item-title">@n.Title</div>
                                            @if (!string.IsNullOrWhiteSpace(n.Message))
                                            {
                                                <div class="notif-item-message">@n.Message</div>
                                            }
                                            <div class="notif-item-time">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                        </a>
                                    }
                                }
                                <a href="/Notifications/Index" class="notif-dropdown-footer">@SharedLocalizer["ViewAll"]</a>
                            </div>
                        </div>
                        <span>@User.FindFirst("DisplayName")?.Value (@User.Identity?.Name)</span>
                        <form method="post" asp-page="/Account/Logout" class="inline-form">
                            <button type="submit" class="btn btn-link">@SharedLocalizer["SignOut"]</button>
                        </form>
                    }
                </div>
            </header>
            @if ((bool?)ViewData["IsImpersonating"] == true)
            {
                <div class="impersonation-banner">
                    <span>@SharedLocalizer["ImpersonatingLabel"] <strong>@User.FindFirst("DisplayName")?.Value</strong>
                        (@(string.IsNullOrEmpty(User.FindFirst("EmpCode")?.Value) ? User.Identity!.Name : $"{SharedLocalizer["Employee"]} {User.FindFirst("EmpCode")!.Value}"))
                        — @SharedLocalizer["SignedInAsLabel"] @ViewData["OriginalAdminDisplayName"]</span>
                    <form method="post" asp-page="/Admin/LoginAs" asp-page-handler="Return" class="inline-form">
                        <button type="submit" class="btn btn-utility">@SharedLocalizer["ReturnToAdministrator"]</button>
                    </form>
                </div>
            }
            <main class="page" id="main-content" tabindex="-1">
                @RenderBody()
            </main>
            @if (!string.IsNullOrWhiteSpace(branding.FooterText))
            {
                <footer class="app-footer">@branding.FooterText</footer>
            }
        </div>
    </div>

    <div class="toast-stack" id="toastStack" role="status" aria-live="polite"></div>

    <script src="~/js/searchable-select.js" asp-append-version="true"></script>
    <script>
        function showToast(text, type) {
            var stack = document.getElementById('toastStack');
            if (!stack || !text) return;
            var toast = document.createElement('div');
            toast.className = 'toast' + (type === 'error' ? ' error' : '');
            var icon = document.createElement('span');
            icon.className = 'toast-icon';
            icon.textContent = type === 'error' ? '⚠️' : '✅';
            var span = document.createElement('span');
            span.className = 'toast-text';
            span.textContent = text;
            var close = document.createElement('button');
            close.type = 'button';
            close.className = 'toast-close';
            close.setAttribute('aria-label', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Dismiss"].Value)));
            close.textContent = '✕';
            var remove = function() {
                toast.classList.add('leaving');
                setTimeout(function() { toast.remove(); }, 200);
            };
            close.addEventListener('click', remove);
            toast.append(icon, span, close);
            stack.appendChild(toast);
            setTimeout(remove, 5000);
        }

        // Mobile (<=640px, matching site.css's overlay-mode breakpoint) gets its own sidebar
        // behavior: always starts collapsed (never restored from desktop's saved preference),
        // closes on an outside tap, and closes after picking a nav link — none of which apply
        // above that breakpoint, where the existing desktop behavior (open by default, state
        // remembered across visits) is untouched.
        var isMobileViewport = function () { return window.matchMedia('(max-width: 640px)').matches; };
        var sidebarEl = document.getElementById('sidebar');

        document.getElementById('sidebarToggle')?.addEventListener('click', function() {
            sidebarEl.classList.toggle('collapsed');
            if (!isMobileViewport()) {
                localStorage.setItem('sidebarCollapsed', sidebarEl.classList.contains('collapsed'));
            }
        });

        // Initial state: mobile always starts collapsed; desktop restores its last preference.
        if (isMobileViewport()) {
            sidebarEl?.classList.add('collapsed');
        } else if (localStorage.getItem('sidebarCollapsed') === 'true') {
            sidebarEl?.classList.add('collapsed');
        }

        // Mobile: tapping anywhere outside the open sidebar (and its toggle button) closes it.
        document.addEventListener('click', function(e) {
            if (!isMobileViewport() || !sidebarEl || sidebarEl.classList.contains('collapsed')) return;
            var toggleBtn = document.getElementById('sidebarToggle');
            if (sidebarEl.contains(e.target) || toggleBtn?.contains(e.target)) return;
            sidebarEl.classList.add('collapsed');
        });

        // Mobile: selecting a nav link closes the sidebar instead of leaving it open over the
        // page that link just navigated to.
        sidebarEl?.querySelectorAll('.sidebar-link').forEach(function(link) {
            link.addEventListener('click', function() {
                if (isMobileViewport()) sidebarEl.classList.add('collapsed');
            });
        });

        document.getElementById('notifBellBtn')?.addEventListener('click', function(e) {
            e.stopPropagation();
            var open = document.getElementById('notifDropdown')?.classList.toggle('open');
            this.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        document.addEventListener('click', function(e) {
            var dropdown = document.getElementById('notifDropdown');
            var btn = document.getElementById('notifBellBtn');
            if (dropdown && dropdown.classList.contains('open') && !dropdown.contains(e.target) && e.target !== btn) {
                dropdown.classList.remove('open');
                btn?.setAttribute('aria-expanded', 'false');
            }
        });
        document.addEventListener('keydown', function(e) {
            if (e.key !== 'Escape') return;
            var dropdown = document.getElementById('notifDropdown');
            if (dropdown?.classList.contains('open')) {
                dropdown.classList.remove('open');
                document.getElementById('notifBellBtn')?.setAttribute('aria-expanded', 'false');
            }
        });

        @if (!string.IsNullOrEmpty(toastSuccess))
        {
            @:showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastSuccess)), 'success');
        }
        @if (!string.IsNullOrEmpty(toastError))
        {
            @:showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastError)), 'error');
        }

        // ---- Prevent duplicate submissions ---------------------------------
        // Disables every submit button in a form shortly after it's submitted, so a slow
        // request (or an impatient double-click) can't fire the same POST twice. The page
        // navigates away right after anyway, so there's no need to re-enable on success;
        // native browser validation (required/pattern) still runs first and blocks invalid
        // submissions, which never reach this handler.
        //
        // The disabling is deferred a tick (setTimeout 0) rather than done inline in the
        // listener. The browser reads the form's current control values to build the actual
        // submission (query string for GET, request body for POST) only AFTER the 'submit'
        // event finishes dispatching — and a disabled control's name/value is excluded from
        // that data set. Disabling synchronously, inside this same capture-phase listener,
        // was stripping the CLICKED BUTTON's own name/value from the submission whenever a
        // page relied on it (e.g. Reports' "<button name='handler' value='EmployeePdf'>",
        // which picks the Razor Page handler to run) — the export silently fell back to the
        // plain page-load handler with none of the intended filters ever reaching it. A one
        // tick delay is imperceptible for the "prevent double submit" UX but happens after
        // the browser has already captured this submission's data, so it can no longer
        // affect what gets sent.
        document.addEventListener('submit', function(e) {
            var form = e.target;
            // hasAttribute(), not dataset — a bare `data-no-dupe-guard` (no ="value") reads back
            // as dataset.noDupeGuard === "" (the empty string), which is FALSY, so a naive
            // `if (form.dataset.noDupeGuard)` check silently never fires for exactly the plain,
            // valueless attribute form every call site here actually uses. This is the same class
            // of bug that broke the unsaved-changes exemption below (see that section's comment)
            // — fixed the same way in both places so it can't resurface from copy-pasting one
            // into the other.
            if (!(form instanceof HTMLFormElement) || form.hasAttribute('data-no-dupe-guard')) return;
            setTimeout(function () {
                form.querySelectorAll('button[type="submit"], input[type="submit"]').forEach(function(btn) {
                    btn.disabled = true;
                    btn.classList.add('is-submitting');
                });
            }, 0);
        }, true);

        // ---- Unsaved-changes warning ----------------------------------------
        //
        // Design: a page is dirty — worth a native "leave site?" confirmation — only when a POST
        // form whose purpose is to SAVE content has an actual, un-submitted edit sitting in it.
        // Internal workflow navigation (reloading the page with different query parameters —
        // PM Form's Department/Employee/Year selector, every search/filter form in the app,
        // language switching) has nothing to lose by definition, so it's excluded from tracking
        // up front instead of being tracked and then reset:
        //
        //  - GET forms and links are never tracked below. This is not a special case; it's the
        //    reason every filter/search form in the app (Employees, Users, Reports,
        //    WorkflowAdmin, and now PM Form's own selector) is deliberately method="get" — the
        //    HTTP verb itself is the "this is navigation, not a save" signal, which can't be
        //    silently defeated by a broken JS attribute check the way the old design was.
        //  - A POST form that is ALSO pure navigation for some other technical reason (e.g.
        //    Account/Login, which must be POST so credentials never land in a query string, but
        //    still shouldn't warn if the user clicks the language toggle mid-type) opts out with
        //    an explicit `data-dirty-tracking="off"` — a real value, checked with strict `===`.
        //
        // Why not the old `data-no-dirty-check` bare attribute? `element.dataset.foo` on a
        // present-but-valueless `data-foo` attribute reads back as "" (the empty string), and ""
        // is falsy — so `if (form.dataset.noDirtyCheck)` silently never returned early for the
        // exact plain `data-no-dirty-check` (no ="true") every affected form actually used. That
        // form was correctly marked exempt in the HTML and still got tracked anyway, which is
        // exactly why the "Leave site?" prompt kept firing on every Department/Employee change
        // despite the earlier fix looking correct on inspection. Comparing against a real string
        // value removes the whole class of "did the bare attribute actually work" doubt.
        //
        // A tracked form's own submission is always an intentional save, not a loss — listened
        // for once, in the capture phase, on the document itself (not per-form), so it covers
        // every current and future save path (a real click, Enter-to-submit, requestSubmit())
        // without each page having to remember to reset anything. This is no longer standing in
        // for the exemption above (as it used to for the selector's programmatic form.submit()
        // calls, which never fire a 'submit' event at all per spec, and so were never actually
        // reset by this): every form that calls .submit() directly is GET, hence never tracked
        // in the first place, so there's nothing left for this listener to paper over.
        var dirtyForms = new Set();
        document.querySelectorAll('form').forEach(function(form) {
            if (form.method.toLowerCase() !== 'post') return;
            if (form.dataset.dirtyTracking === 'off') return;
            form.addEventListener('input', function() { dirtyForms.add(form); });
            form.addEventListener('change', function() { dirtyForms.add(form); });
        });
        document.addEventListener('submit', function(e) {
            if (e.target instanceof HTMLFormElement) dirtyForms.delete(e.target);
        }, true);
        window.addEventListener('beforeunload', function(e) {
            if (dirtyForms.size === 0) return;
            e.preventDefault();
            e.returnValue = '';
        });
    </script>
</body>
</html>
