@page
@model PerformanceManagement.Web.Pages.Users.EditModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = Model.IsNew ? Localizer["PageTitleNew"].Value : Localizer["EditUserHeader", Model.Form.UserName].Value;
}
<div class="page-header">@(Model.IsNew ? Localizer["CreateUserHeader"] : Localizer["EditUserHeader", Model.Form.UserName])</div>

@if (Model.Error is not null) { <div class="alert alert-error">@Model.Error</div> }

<div class="card">
    <div class="card-header">@Localizer["UserDetailsHeader"]</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Save" asp-route-id="@Model.Id">
            <div class="grid-3" style="margin-bottom:14px;">
                <div>
                    <label for="userType">@Localizer["UserTypeLabel"]</label>
                    <select name="Form.UserType" id="userType" onchange="toggleUserType()">
                        <option value="@PerformanceManagement.Core.Domain.UserType.Employee" selected="@(Model.Form.UserType == PerformanceManagement.Core.Domain.UserType.Employee)">@Localizer["UserTypeEmployee"]</option>
                        <option value="@PerformanceManagement.Core.Domain.UserType.Administrator" selected="@(Model.Form.UserType == PerformanceManagement.Core.Domain.UserType.Administrator)">@Localizer["UserTypeAdministrator"]</option>
                        <option value="@PerformanceManagement.Core.Domain.UserType.Viewer" selected="@(Model.Form.UserType == PerformanceManagement.Core.Domain.UserType.Viewer)">@Localizer["UserTypeViewer"]</option>
                    </select>
                </div>
                <div>
                    <label for="userNameInput">@SharedLocalizer["Username"]</label>
                    <input type="text" id="userNameInput" name="Form.UserName" value="@Model.Form.UserName" maxlength="50" />
                </div>
                <div>
                    <label style="text-transform:none;">
                        <input type="checkbox" name="Form.IsActive" value="true" style="width:auto;" checked="@Model.Form.IsActive" /><input type="hidden" name="Form.IsActive" value="false" /> @SharedLocalizer["Active"]
                    </label>
                </div>
            </div>

            <div id="employeeSection" class="grid-2" style="margin-bottom:14px;">
                <div>
                    <label for="empSelect">@SharedLocalizer["Employee"]</label>
                    <select name="Form.EmpCode" id="empSelect" data-searchable onchange="fillFromEmployee()" data-selected="@Model.Form.EmpCode">
                        <option value="">@Localizer["SelectEmployeePlaceholder"]</option>
                        @foreach (var (code, label, email) in Model.EmployeeOptions)
                        {
                            <option value="@code" data-email="@email" selected="@(code == Model.Form.EmpCode)">@label</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="empNameDisplay">@Localizer["NameFromEmployeeMasterLabel"]</label>
                    <input type="text" id="empNameDisplay" readonly value="@Model.Form.FullName" />
                </div>
            </div>

            <div id="manualNameSection" class="grid-2" style="margin-bottom:14px;">
                <div>
                    <label for="fullNameInput">@Localizer["FullNameLabel"]</label>
                    <input type="text" name="Form.FullName" id="fullNameInput" value="@Model.Form.FullName" maxlength="100" />
                </div>
                <div></div>
            </div>

            <div class="grid-2" style="margin-bottom:14px;">
                <div>
                    <label for="emailInput">@Localizer["EmailAddressLabel"]</label>
                    <input type="text" name="Form.Email" id="emailInput" value="@Model.Form.Email" />
                </div>
            </div>

            @if (Model.IsNew)
            {
                <div class="card" style="margin-bottom:14px;background:var(--surface);">
                    <div class="card-body">
                        <div class="grid-3">
                            <div>
                                <label for="passwordInput">@SharedLocalizer["Password"]</label>
                                <input type="text" id="passwordInput" name="Form.Password" placeholder="@Model.DefaultPasswordHint" />
                                <p class="muted" style="margin:4px 0 0;font-size:12px;">@Model.PasswordRuleHint</p>
                            </div>
                            <div>
                                <label style="text-transform:none;">
                                    <input type="checkbox" name="Form.UseDefaultPassword" value="true" style="width:auto;" /> @Localizer["UseDefaultPasswordLabel", Model.DefaultPasswordHint]
                                </label>
                            </div>
                            <div>
                                <label style="text-transform:none;">
                                    <input type="checkbox" name="Form.ForceChangePassword" value="true" style="width:auto;" checked="true" /> @Localizer["ForceChangePasswordLabel"]
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@(Model.IsNew ? Localizer["CreateUserButton"] : Localizer["SaveChangesButton"])</button>
                <a class="btn btn-secondary" asp-page="Index">@SharedLocalizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.IsNew)
{
    <div class="card">
        <div class="card-header">@Localizer["ResetPasswordHeader"]</div>
        <div class="card-body">
            <p class="muted" style="margin-top:0;">@Localizer["ResetPasswordNote"]</p>
            <form method="post" asp-page-handler="ResetPassword" asp-route-id="@Model.Id">
                <div class="grid-3">
                    <div>
                        <label for="resetPasswordInput">@SharedLocalizer["NewPassword"]</label>
                        <input type="text" id="resetPasswordInput" name="Form.Password" placeholder="@Model.DefaultPasswordHint" />
                        <p class="muted" style="margin:4px 0 0;font-size:12px;">@Model.PasswordRuleHint</p>
                    </div>
                    <div>
                        <label style="text-transform:none;">
                            <input type="checkbox" name="Form.UseDefaultPassword" value="true" style="width:auto;" /> @Localizer["UseDefaultPasswordLabel", Model.DefaultPasswordHint]
                        </label>
                    </div>
                    <div>
                        <label style="text-transform:none;">
                            <input type="checkbox" name="Form.ForceChangePassword" value="true" style="width:auto;" checked="true" /> @Localizer["ForceChangePasswordLabel"]
                        </label>
                    </div>
                </div>
                <div class="form-actions" style="margin-top:14px;">
                    <button type="submit" class="btn btn-danger">@Localizer["ResetPasswordButton"]</button>
                </div>
            </form>
        </div>
    </div>
}

<script>
    function toggleUserType() {
        const t = document.getElementById('userType').value;
        const isEmployee = t === '@PerformanceManagement.Core.Domain.UserType.Employee';
        document.getElementById('employeeSection').style.display = isEmployee ? '' : 'none';
        document.getElementById('manualNameSection').style.display = isEmployee ? 'none' : '';
    }
    function fillFromEmployee() {
        const sel = document.getElementById('empSelect');
        const opt = sel.options[sel.selectedIndex];
        const label = opt ? opt.textContent : '';
        const name = label.includes('|') ? label.split('|')[1].trim() : '';
        document.getElementById('empNameDisplay').value = name;
        const email = opt ? (opt.getAttribute('data-email') || '') : '';
        if (email) document.getElementById('emailInput').value = email;
    }
    toggleUserType();
</script>
