@page
@model PerformanceManagement.Web.Pages.Users.IndexModel
@{
    ViewData["Title"] = "User Management";
}
<div class="page-header">User Management</div>

<div class="card">
    <div class="card-header">Search</div>
    <div class="card-body">
        <form method="get">
            <div class="filters">
                <div><label for="userSearchQ">Search (username, name, email)</label><input type="text" id="userSearchQ" name="q" value="@Model.Q" /></div>
                <div></div><div></div><div></div>
                <div style="display:flex;gap:8px;">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a class="btn btn-success" asp-page="Edit">＋ New User</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-scroll">
<table class="grid">
    <thead>
        <tr><th>Username</th><th>Full Name</th><th>Email</th><th>User Type</th><th>Linked Employee</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td>@r.UserName</td>
            <td>@r.DisplayName</td>
            <td>@r.Email</td>
            <td>@PerformanceManagement.Web.Pages.Users.UserTypes.Label(r.UserType)</td>
            <td>@r.EmpCode</td>
            <td>
                @(r.IsActive ? "Active" : "Disabled")
                @if (r.MustChangePassword) { <span class="muted">· must change password</span> }
            </td>
            <td><a class="btn btn-secondary" style="padding:4px 12px;font-size:12px;" asp-page="Edit" asp-route-id="@r.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
</div>
<p class="muted">@Model.Rows.Count users.</p>
