@page
@model PerformanceManagement.Web.Pages.Users.IndexModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<PerformanceManagement.Web.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["NavUserManagement"].Value;

    string UserTypeLabel(string userType) => userType switch
    {
        PerformanceManagement.Core.Domain.UserType.Administrator => Localizer["UserTypeAdministrator"].Value,
        PerformanceManagement.Core.Domain.UserType.Viewer => Localizer["UserTypeViewer"].Value,
        _ => Localizer["UserTypeEmployee"].Value
    };
}
<div class="page-header">@SharedLocalizer["NavUserManagement"]</div>

<div class="card">
    <div class="card-header">@SharedLocalizer["Search"]</div>
    <div class="card-body">
        <form method="get">
            <div class="filters">
                <div><label for="userSearchQ">@Localizer["SearchUsernameNameEmailLabel"]</label><input type="text" id="userSearchQ" name="q" value="@Model.Q" /></div>
                <div></div><div></div><div></div>
                <div style="display:flex;gap:8px;">
                    <button type="submit" class="btn btn-primary">@SharedLocalizer["Search"]</button>
                    <a class="btn btn-success" asp-page="Edit">＋ @Localizer["NewUserButton"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-scroll">
<table class="grid">
    <thead>
        <tr><th>@SharedLocalizer["Username"]</th><th>@Localizer["ColFullName"]</th><th>@SharedLocalizer["Email"]</th><th>@Localizer["ColUserType"]</th><th>@Localizer["ColLinkedEmployee"]</th><th>@SharedLocalizer["Status"]</th><th></th></tr>
    </thead>
    <tbody>
    @if (Model.Rows.Count == 0)
    {
        <tr><td colspan="7" class="muted" style="text-align:center;padding:24px;">@Localizer["NoUsersMatch"]</td></tr>
    }
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td>@r.UserName</td>
            <td>@r.DisplayName</td>
            <td>@r.Email</td>
            <td>@UserTypeLabel(r.UserType)</td>
            <td>@r.EmpCode</td>
            <td>
                @(r.IsActive ? SharedLocalizer["Active"] : SharedLocalizer["Disabled"])
                @if (r.MustChangePassword) { <span class="muted">@Localizer["MustChangePasswordNote"]</span> }
            </td>
            <td><a class="btn btn-secondary btn-sm" asp-page="Edit" asp-route-id="@r.Id">@SharedLocalizer["Edit"]</a></td>
        </tr>
    }
    </tbody>
</table>
</div>
<p class="muted">@Localizer["UserCountSummary", Model.Rows.Count]</p>
